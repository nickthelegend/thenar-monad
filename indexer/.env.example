# Thenar indexer — copy to `.env` (Envio loads it), or set the same names in
# Envio Cloud → Settings → Environment Variables.
# Envio only passes through variables prefixed with ENVIO_. Every value below
# is optional: the defaults are lib/deployment.ts and lib/deployment-local.ts.

# --- HyperSync ---------------------------------------------------------------
# Required for Monad testnet. Free: https://envio.dev/app/api-tokens
# ENVIO_API_TOKEN=<your-api-token>

# --- Which chains ------------------------------------------------------------
# Monad testnet (10143) is skipped until you have a token. Set to false to index it.
ENVIO_THENAR_SKIP_MONAD=true
# The local anvil chain (31337). Set to true to stop indexing it.
ENVIO_THENAR_SKIP_LOCAL=false

# --- Monad testnet (10143) ---------------------------------------------------
# ENVIO_THENAR_MONAD_START_BLOCK=64987386
# ENVIO_THENAR_MONAD_HYPERSYNC_URL=https://monad-testnet.hypersync.xyz
# ENVIO_MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
# With a token the RPC is a fallback. Without one, `sync` makes it the only
# source — works, but the public RPC answers eth_getLogs 100 blocks at a time.
# ENVIO_THENAR_MONAD_RPC_FOR=fallback
# ENVIO_THENAR_MONAD_AXON=0x17731731c6652770CE630e29b62791DC2CED5f38
# ENVIO_THENAR_MONAD_SALES_LOG=0xf34A45021B8006C141E8b9CFe4B8a509a9b1fE27
# ENVIO_THENAR_MONAD_CORPUS_SHARES=0xAE1F24fE0F759BEF941eA2Df2dcb23dc3e130fc7
# ENVIO_THENAR_MONAD_PASSKEY_REGISTRY=0xE344179839c9cA2101Ad930BD49268103F3945a9
# ENVIO_THENAR_MONAD_CORPUS_ACCESS=0xD0ad261D8d7a3D5a1D0Bf6Ed6EbE4BAD691b4AA1

# --- Local anvil (31337) -----------------------------------------------------
# ENVIO_THENAR_LOCAL_RPC_URL=http://127.0.0.1:8645
# ENVIO_THENAR_LOCAL_START_BLOCK=0
# ENVIO_THENAR_LOCAL_AXON=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
# ENVIO_THENAR_LOCAL_SALES_LOG=0xa513E6E4b8f2a923D98304ec87F64353C4D5C853
# ENVIO_THENAR_LOCAL_CORPUS_SHARES=0x0165878A594ca255338adfa4d48449f69242Eb8F
# ENVIO_THENAR_LOCAL_PASSKEY_REGISTRY=0x5FbDB2315678afecb367f032d93F642f64180aa3
# ENVIO_THENAR_LOCAL_CORPUS_ACCESS=0xDc64a140Aa3E981100a9becA4E685f962f0cF6C9

# --- Database (read by scripts/start.sh; these are the defaults) -------------
# Point the indexer at thenar-envio-pg / thenar-envio-hasura from db.compose.yaml,
# never at the fixed-name envio-postgres / envio-hasura another project owns.
# THENAR_ENVIO_PG_PORT=55441
# THENAR_ENVIO_PG_PASSWORD=thenar-envio
# THENAR_ENVIO_HASURA_PORT=8089
# THENAR_ENVIO_HASURA_SECRET=thenar-admin
# ENVIO_INDEXER_PORT=9941
